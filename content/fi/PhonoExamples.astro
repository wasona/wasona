---
import Audio from "@/components/Audio.astro";
---

<style>
  table {
    text-align: center;
  }
  td:last-child {
    text-align: initial;
  }
</style>
<table>
  <thead>
    <tr>
      <th>Sana</th>
      <th>Merkitys</th>
      <th>Vinkkejä</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <Audio td from="linku/asi" file="wawa" />
      <td>vahva</td>
      <td>Huomaa <b>w</b>:n pyöreys</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="sina" />
      <td>sinä</td>
      <td>Tarkkana <b>a</b>:n kanssa</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="ma" />
      <td>maa</td>
      <td>Kaksoisvokaalin puuttuessa äänteen venyminen ei aiheuta sekaannuksia</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="nanpa" />
      <td>number</td>
      <td>Tavujen välinen <b>np</b> voidaan lausua myös <b>mp</b>
      </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="ijo" />
      <td>asia</td>
      <td>Sanat voivat alkaa myös vokaalilla</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kala" />
      <td>kala</td>
      <td>Kuten suomeksi</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kalama" />
      <td>ääni</td>
      <td></td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="jan" />
      <td>ihminen</td>
      <td></td>
    </tr>
  </tbody>
</table>
