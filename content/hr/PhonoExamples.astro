---
import Audio from "@/components/Audio.astro";
---

<style>
  table {
    text-align: center;
  }
  td:last-child() {
    text-align: initial;
  }
</style>
<table>
  <thead>
    <tr>
      <th>Riječ</th>
      <th>Značenje</th>
      <th>Korisni savjeti</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <Audio td from="linku/asi" file="mi" />
      <td>ja</td>
      <td>Samoglasnik je sličan hrvatskom jeziku, ali je pisanje drugačije!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="ken" />
      <td>može</td>
      <td>Samoglasnik je sličan hrvatskom jeziku, ali je pisanje drugačije!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="jan" />
      <td>person</td>
      <td>Sjećaj se kako se suglasnik <b>j</b> izgovori! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kute" />
      <td>hear</td>
      <td>Samoglasnik - <b>e</b> na kraju je stvarni samoglasnik! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="nanpa" />
      <td>number</td>
      <td
        >Usput, mi slovkamo <b>np</b>, ali mi često izgovorimo <b>mp</b>!
      </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kalama" />
      <td>sound</td>
      <td>Pokušaj svoju mogućnost stresiranja prvoga sloga!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="akesi" />
      <td>lizard</td>
      <td>Riječi mogu početi na samoglasnik!</td>
    </tr>
  </tbody>
</table>
