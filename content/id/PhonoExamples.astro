---
import Audio from "@/components/Audio.astro";
---

<style>
  table {
    text-align: center;
  }
  td:last-child {
    text-align: initial;
  }
</style>
<table>
  <thead>
    <tr>
      <th>Kata</th>
      <th>Arti</th>
      <th>Tips pelafalan</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <Audio td from="linku/asi" file="mi" />
      <td>aku</td>
      <td>Bunyikan vokalnya seperti dalam bahasa Indonesia.</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="ken" />
      <td>bisa</td>
      <td>Bunyikan vokalnya seperti dalam bahasa Indonesia.</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="jan" />
      <td>orang</td>
      <td>Ingat, huruf <b>j</b> dilafalkan seperti <b>y</b> dalam bahasa Indonesia! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kute" />
      <td>mendengar</td>
      <td>Huruf <b>e</b> di akhir tetap dibunyikan, seperti <b>e</b> pada kata <i>enak</i>! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="nanpa" />
      <td>angka</td>
      <td
        >Ditulis <b>np</b>, tetapi biasanya dilafalkan <b>mp</b>!
      </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kalama" />
      <td>bunyi</td>
      <td>Cobalah memberi tekanan pada suku kata pertama!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="akesi" />
      <td>kadal</td>
      <td>Kata juga bisa diawali vokal!</td>
    </tr>
  </tbody>
</table>
