---
import Audio from "@/components/Audio.astro";
---

<style>
  table {
    text-align: center;
  }
  td:last-child {
    text-align: initial;
  }
</style>
<table>
  <thead>
    <tr>
      <th>Slovo</th>
      <th>Značenje</th>
      <th>Koristne sověty</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <Audio td from="linku/asi" file="jan" />
      <td>člověk</td>
      <td>Zapametajte izgovor bukvy <b>j</b>!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="telo" />
      <td>voda</td>
      <td><b>i</b> i <b>e</b> ne silno směkčajut konsonant — <i>telo</i>, ne <i>tělo</i>!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kute" />
      <td>slyšati</td>
      <td>Bukva <b>e</b> na koncu zaisto davaje zvuk, ne jest něma!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="wawa" />
      <td>sila</td>
      <td>Praktikujte izgovor bukvy <b>w</b>!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="nanpa" />
      <td>čislo</td>
      <td
        >Mimohodom, pišemo <b>np</b>, ale obyčno izgovarjajemo <b>mp</b>!
      </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kalama" />
      <td>zvuk</td>
      <td>Prověrite, že akcent padaje na prvy slog!</td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="akesi" />
      <td>jaščer</td>
      <td>Slova mogut počinati se samoglaskoju!</td>
    </tr>
  </tbody>
</table>
