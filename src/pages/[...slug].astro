---
import "selo-components/common.css"; // has to be above site-specific css

import PageNav from "@/components/PageNav.astro";
import SessionRestore from "@/components/capacitor/SessionRestore.astro";
import AndroidNav from "@/components/capacitor/AndroidNav.astro";
import "@/global.css";
import { getLang, posts, prevnexts } from "@/lib/content";
import { render } from "astro:content";
import { Layout } from "selo-components";

export const langCodeAlts: Record<string, string[]> = {
  'cs': ['cz'],
  'uk': ['ua'],
};

export async function getStaticPaths() {
  let paths = [];
  for (let post of posts) {
    paths.push({
      params: { slug: post.id },
      props: { post },
    });

    let langCode = post.id.split("/")[0];
    for (let altCode of langCodeAlts[langCode] ?? []) {
      let components = post.id.split("/");
      components[0] = altCode;
      paths.push({
        params: { slug: components.join("/") },
        props: { post, redirect: true },
      });
    }
  }
  return paths;
}

const { post, redirect } = Astro.props;
if (redirect) return Astro.redirect(`/${post.id}`);
const { Content } = await render(post);
const lang = getLang(post);
const prevnext = post.filePath!.includes("index.md")
  ? undefined
  : prevnexts[lang][post.id];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  dir={["he", "ar"].includes(lang) ? "rtl" : "ltr"}
  lang={["jp"].includes(lang) ? lang : "en"}
>
  <SessionRestore slot="head"></SessionRestore>
  <PageNav prevnext={prevnext} current={post.id} slot="pagenav" />
  <Content />
</Layout>
<AndroidNav></AndroidNav>
