---
import Practice from "@/components/game/Practice.svelte";
import { type Exercise } from "@/lib/exercise";
import { locales } from "@/lib/i18n";
interface Props {
  exercises: Exercise[];
}
const { exercises } = Astro.props;
const locale = locales[Astro.currentLocale!];
---

