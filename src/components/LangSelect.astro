---
import { langs, languageMetadata } from "@/lib/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  current: string;
}

const currentPageLang = Astro.url.pathname.startsWith("/translate/")
  ? "translate"
  : (Astro.currentLocale ?? "en");
const languageLinks = langs
  .map((code) => ({
    code,
    name: languageMetadata[code].endonym,
    url: getRelativeLocaleUrl(code),
  }))
  .sort((a, b) =>
    a.code === "en"
      ? -1
      : b.code === "en"
        ? 1
        : a.name.localeCompare(b.name, undefined, { sensitivity: "base" }),
  );
---

<style>
  nav {
    width: 100%;
    padding: 20px 0;
    text-align: center;
    border-top: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
  }
  .selector-actions,
  .selector-actions details,
  .selector-actions summary,
  .recommendations {
    display: inline;
  }
  .all-language-list {
    display: block;
    padding-top: 0.7rem;
  }
  summary {
    cursor: pointer;
    color: var(--accent);
    text-decoration: underline dotted;
    text-underline-position: under;
    font-weight: bold;
    list-style: none;
    white-space: nowrap;
  }
  summary:active,
  summary:hover {
      color: var(--accent-1) !important;
  }

  summary::-webkit-details-marker {
    display: none;
  }
  a {
    white-space: nowrap;
  }
</style>

<nav
  aria-label="Course languages"
  dir="ltr"
  data-language-selector
  data-languages={JSON.stringify(languageMetadata)}
>
  <div class="selector-actions">
    {
      currentPageLang === "en" ? (
        <strong lang="en">English</strong>
      ) : (
        <a href={getRelativeLocaleUrl("en")} lang="en">English</a>
      )
    }
    <span class="recommendations" data-recommendations></span>
    <b class="separator" aria-hidden="true">{" · "}</b>
    <details>
      <summary>All languages ({langs.length})</summary>
      <div class="all-language-list">
        {
          languageLinks
            .map(({ code, name, url }) =>
              code === currentPageLang ? (
                <strong lang={code} dir="auto" data-language-option={code}>{name}</strong>
              ) : (
                <a href={url} lang={code} dir="auto" data-language-option={code}>{name}</a>
              ),
            )
            .reduce((previous, current) => (
              <>{previous}<b class="separator" aria-hidden="true">{" · "}</b>{current}</>
            ))
        }
        <b class="separator" aria-hidden="true">{" · "}</b>
        {currentPageLang === "translate"
          ? <strong>Add language</strong>
          : <a href="/translate/">Add language</a>}
      </div>
    </details>
  </div>
</nav>

<script>
  import timeZoneData from "@/data/timezone-countries.json";
import fallbackLanguagesByZone from "@/data/timezone-language-fallbacks.json";
import { recommendLanguages, type LanguageMetadata } from "@/lib/language-recommendations";

  const constructedLanguages = ["isv", "eo"];

  document.querySelectorAll<HTMLElement>("[data-language-selector]").forEach((selector) => {
    const languages = JSON.parse(selector.dataset.languages ?? "{}") as Record<string, LanguageMetadata>;
    const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone ?? "";
    const browserLanguages = navigator.languages?.length
      ? navigator.languages
      : [navigator.language];
    const recommendations = recommendLanguages({
      languages,
      constructedLanguages,
      browserLanguages,
      timeZone,
      countriesByZone: timeZoneData.zones,
      fallbackLanguagesByZone,
      fallbackAliases: timeZoneData.fallbackAliases,
    });
    const container = selector.querySelector<HTMLElement>("[data-recommendations]");
    if (!container) return;

    for (const code of recommendations) {
      const option = selector.querySelector<HTMLElement>(`[data-language-option="${code}"]`);
      if (!option) continue;
      const separator = document.createElement("b");
      separator.className = "separator";
      separator.setAttribute("aria-hidden", "true");
      separator.textContent = " · ";
      container.append(separator, option.cloneNode(true));
    }
  });
</script>
