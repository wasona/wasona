---
import { langs, locales } from "@/lib/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
interface Props {
  current: string;
}
const current = Astro.currentLocale!;
const langLinks = [];
for (let lang of langs) {
  langLinks.push([lang, locales[lang]["lang_name"], getRelativeLocaleUrl(lang)]);
}
langLinks.push(["translate", locales[current]["add_language"] ?? "add language", "/translate/"]);
const highlightLang = Astro.url.pathname === "/translate/" ? "translate" : current;
---

<style>
  nav {
    width: 100%;
    padding: 20px 0px;
    text-align: center;
    border-top: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
  }
  a {
    white-space: nowrap;
  }
</style>

<nav dir="ltr">
  {
    langLinks
    .map(([lang, langName, url]) =>
        lang === highlightLang ? (
          <strong>{langName}</strong>
        ) : (
          <a dir="ltr" href={url}>{langName}</a>
        ),
      )
      .reduce((prev, curr, i) => (
        <>
          {prev} <b>{" · "}</b> {curr}
        </>
      ))
  }
</nav>
